# Copy this file to .env and replace every CHANGE_ME. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $:
# a value containing $ is treated as a placeholder and the application fails to start.

# Database. MySQL runs from the infra repository, which creates the energy_app user with
# MYSQL_PASSWORD of infra/.env. Put that same password here: the tests need it, because the
# "test" profile does not load application-local.yaml.
SPRING_DATASOURCE_PASSWORD=

# HTTP port. 8080 is the API gateway, 8082 the security service, 8083 energy-monitor-backend,
# 8084 the device service, 8085 the measurement service and 8086 the home service on the same
# machine.
# SERVER_PORT=8087

# Public key of the security service, to validate the access tokens. Absolute path.
SECURITY_JWT_PUBLIC_KEY_PATH=/home/CHANGE_ME/.energy-monitor/keys/public.pem

# Calls to the other services. The same INTERNAL_API_TOKEN as in infra/.env and every service:
# empty, they refuse every call.
INTERNAL_API_TOKEN=CHANGE_ME
# Profiles of the recipients, the administrators and the permissions of the admin routes.
SECURITY_SERVICE_URL=http://localhost:8082
# The members and the name of a home.
HOME_SERVICE_URL=http://localhost:8086
# The name of a device.
DEVICE_SERVICE_URL=http://localhost:8084

# Web Push (VAPID): the same pair as energy-monitor-backend, or every subscribed browser stops
# receiving alerts. Empty = Web Push disabled.
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
# Push to the mobile apps through Expo (expo.dev, Access tokens). Empty = app push disabled.
EXPO_ACCESS_TOKEN=

# Mail (alerts, recommendations, verification and recovery codes). Gmail: an app password of the
# sending account. Empty username or password = every mail is recorded as failed.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EnergyMonitor <CHANGE_ME@gmail.com>

# RabbitMQ of infra: the account events and mail requests of the security service.
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=CHANGE_ME
# Off until energy-monitor-backend's notification module is removed (see README).
# SECURITY_EVENTS_CONSUMER_ENABLED=false
# Off until energy-monitor-backend's notification module is removed (see README).
# ALERT_EVENTS_CONSUMER_ENABLED=false

# The web app, for the link in the alert mail.
NOTIFICATION_WEB_URL=http://localhost:5173
# The welcome and the home and device activity. On by default; false only to stop telling them.
# ACTIVITY_CONSUMER_ENABLED=true
